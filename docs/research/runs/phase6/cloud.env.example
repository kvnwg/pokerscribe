# The Phase 6 run's tools/cloud settings (README.md in this folder, "The run, step by step").
# Copy to ~/.config/pokerscribe/cloud.env, fill in PROJECT and BUCKET there, and keep the copy
# outside the repo. Every setting is explained in tools/cloud/settings.example.env; the ones
# left out keep their defaults.

PROJECT=
BUCKET=
RUN_NAME=hu-blueprint-1
REGION=us-central1
ZONE=us-central1-a
# Zones with C4A to try when ZONE has no capacity: see python -m tools.cloud check
ZONES=

# 64 Arm cores with 128 GB: the trainer needs 9 GB at its peak (README, "Sizes and costs").
MACHINE_TYPE=c4a-highcpu-64
PROVISIONING=SPOT
PREEMPTION_NOTICE_SECONDS=120
# Spot and on-demand, us-central1, docs/research/BENCHMARKS.md (read 22 Nov 2026). Read the
# current spot price before each launch.
SPOT_PRICE_PER_HOUR=1.3146
STANDARD_PRICE_PER_HOUR=2.4243
# 4 checkpoints of 4.9 GB, 7.5 GB of strategy files, 30 GB for the system and the Rust build:
# 57 GB; 80 leaves room.
DISK_SIZE_GB=80
DISK_TYPE=hyperdisk-balanced
# The free baseline, 140 MiB/s: a 4.9 GB save takes about 35 s and reading it back for the
# upload as long, inside the 2-minute notice (README, "Checkpoints and stages").
DISK_THROUGHPUT_MBPS=
DISK_IOPS=
CHECKPOINT_GB=4.9
ARTIFACTS_GB=7.5
TRAINER_MEMORY_GB=9

# The calibration run: about 2 hours at $1.33 an hour, then the supervisor stops it (state
# "budget"). Raise it for the full run and use resume (README, "The plan").
BUDGET_USD=3
BUDGET_MARGIN_MINUTES=15

TRAINER_MODE=build
TRAINER_CARGO_BIN=blueprint
TRAINER_CARGO_PACKAGE=blueprint
TRAINER_CONFIG=docs/research/runs/phase6/trainer.json
# The bucket tables, built on this computer (README, "The bucket tables"). On the machine
# they are /opt/pscloud/bundle/files/k200, the path trainer.json names.
TRAINER_FILES=~/abstraction/k200
TRAINER_ARGS=
CHECKPOINT_PATTERN=*.ckpt
KEEP_CHECKPOINTS=3
# The strategy file of every stage, stages.jsonl and the trainer's log.jsonl.
ARTIFACT_PATTERNS=*.bps,*.jsonl
