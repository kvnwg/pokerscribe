# The Phase 6 run's tools/cloud settings (README.md in this folder, "The run, step by step").
# Copy to ~/.config/pokerscribe/cloud.env, fill in PROJECT, BUCKET and SERVICE_ACCOUNT there,
# and keep the copy outside the repo. Every setting is explained in
# tools/cloud/settings.example.env; the ones left out keep their defaults.

PROJECT=
BUCKET=
# The machine's own account, with Storage Object Admin on the bucket only (tools/cloud/README.md,
# Setup step 6). The machine gets the storage-rw scope and nothing more.
SERVICE_ACCOUNT=
RUN_NAME=hu-blueprint-1
REGION=us-central1
ZONE=us-central1-a
# Zones with C4A to try when ZONE has no capacity (all four offer C4A, 27 Nov 2026).
ZONES=us-central1-a,us-central1-b,us-central1-c,us-central1-f

# 64 Arm cores with 128 GB: the trainer needs 9 GB at its peak (README, "Sizes and costs").
MACHINE_TYPE=c4a-highcpu-64
PROVISIONING=SPOT
PREEMPTION_NOTICE_SECONDS=120
# Spot and on-demand, us-central1, Google's pricing pages read 27 Nov 2026
# (docs/research/BENCHMARKS.md). Read the current Spot price before each launch.
SPOT_PRICE_PER_HOUR=1.445888
STANDARD_PRICE_PER_HOUR=2.42432
# A Spot machine's external IPv4 (an on-demand one's is IP_PRICE_PER_HOUR, 0.005).
SPOT_IP_PRICE_PER_HOUR=0.0025
# Hyperdisk Balanced: per GB, and per MiB/s above the free 140, per month (27 Nov 2026).
DISK_PRICE_PER_GB_MONTH=0.08
DISK_THROUGHPUT_PRICE_PER_MONTH=0.04
# 4 checkpoints of 4.9 GB, 7.5 GB of strategy files, 30 GB for the system and the Rust build:
# 57 GB; 80 leaves room.
DISK_SIZE_GB=80
DISK_TYPE=hyperdisk-balanced
# 400 MiB/s: a 4.9 GB save and reading it back for the upload take about 12 s each, against
# 35 s each on the free 140 MiB/s; $0.014 an hour more (README, "Checkpoints and stages").
# The IOPS stay at the free 3,000.
DISK_THROUGHPUT_MBPS=400
DISK_IOPS=
CHECKPOINT_GB=4.9
ARTIFACTS_GB=7.5
TRAINER_MEMORY_GB=9

# Kevin's cap for the calibration run (27 Nov 2026). The calibration is stopped by hand after
# about 2 hours (python -m tools.cloud stop); the cap would stop it after about 6.5 hours.
# For the full run raise it to the cap the calibration gives, and use resume (README, "The
# plan").
BUDGET_USD=10
BUDGET_MARGIN_MINUTES=15

TRAINER_MODE=build
TRAINER_CARGO_BIN=blueprint
TRAINER_CARGO_PACKAGE=blueprint
TRAINER_CONFIG=docs/research/runs/phase6/trainer.json
# The bucket tables, built on this computer (README, "The bucket tables"). On the machine
# they are /opt/pscloud/bundle/files/k200, the path trainer.json names.
TRAINER_FILES=~/abstraction/k200
TRAINER_ARGS=
CHECKPOINT_PATTERN=*.ckpt
KEEP_CHECKPOINTS=3
# The strategy file of every stage, stages.jsonl and the trainer's log.jsonl.
ARTIFACT_PATTERNS=*.bps,*.jsonl
