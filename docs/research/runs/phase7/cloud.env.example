# The Phase 7 leaf table build's tools/cloud settings (README.md in this folder, "The run, step
# by step", step 3). Copy to ~/.config/pokerscribe/cloud-leaf.env, fill in PROJECT, BUCKET and
# SERVICE_ACCOUNT there (the Phase 6 run's), and keep the copy outside the repo. Every setting
# is explained in tools/cloud/settings.example.env; the ones left out keep their defaults.

PROJECT=
BUCKET=
SERVICE_ACCOUNT=
# A new run in the same bucket as Phase 6's: gs://<BUCKET>/runs/hu-leaf-512m/.
RUN_NAME=hu-leaf-512m
REGION=us-central1
ZONE=us-central1-a
ZONES=us-central1-a,us-central1-b,us-central1-c,us-central1-f

# 64 Arm cores, as Phase 6. The job needs about 2 GB (1.54 GB measured at 4 threads, README,
# "The leaf tables"); the machine is for its cores.
MACHINE_TYPE=c4a-highcpu-64
PROVISIONING=SPOT
PREEMPTION_NOTICE_SECONDS=120
# us-central1, Google's pricing pages read 27 Nov 2026. Read the current Spot price before the
# launch.
SPOT_PRICE_PER_HOUR=1.445888
STANDARD_PRICE_PER_HOUR=2.42432
SPOT_IP_PRICE_PER_HOUR=0.0025
DISK_PRICE_PER_GB_MONTH=0.08
DISK_THROUGHPUT_PRICE_PER_MONTH=0.04
# As Phase 6, so the price is Phase 6's $1.4714 an hour. The parts (9.7 GB), the table file
# (9.7 GB), the bundle (0.64 GB) and 30 GB for the system and the Rust build need 50 GB. The job
# saves nothing big on SIGTERM (it gives up the part it is building; each part, 0.29 GB, is
# uploaded as it is written).
DISK_SIZE_GB=80
DISK_TYPE=hyperdisk-balanced
DISK_THROUGHPUT_MBPS=400
DISK_IOPS=
CHECKPOINT_GB=0.01
ARTIFACTS_GB=20
TRAINER_MEMORY_GB=3

# About 1.3 to 3.3 hours at $1.4714 an hour (README.md, "The leaf tables"): $8 buys 5.4 hours.
# If the cap stops it, raise BUDGET_USD and resume: the parts done are kept.
BUDGET_USD=8
BUDGET_MARGIN_MINUTES=15

TRAINER_MODE=build
TRAINER_CARGO_BIN=search
TRAINER_CARGO_PACKAGE=search
TRAINER_CONFIG=docs/research/runs/phase7/leaf.json
# The Phase 6 strategy file and the bucket tables it was trained with. On the machine they are
# /opt/pscloud/bundle/files/strategy-512000000.bps and /opt/pscloud/bundle/files/k200, the
# paths leaf.json names. Change the first path if the file is elsewhere on this computer.
TRAINER_FILES=~/phase6/run1/strategy-512000000.bps,~/abstraction/k200
# Empty: the job uses every core of the machine.
TRAINER_ARGS=
# The job's checkpoint is leaf.ckpt; its artifacts are the parts (part-NNNNN.leafpart, 34 of
# 0.29 GB, kept so a new machine goes on from them) and the table file
# (strategy-512000000.bps.leaf, 9.7 GB).
CHECKPOINT_PATTERN=*.ckpt
KEEP_CHECKPOINTS=3
ARTIFACT_PATTERNS=*.leafpart,*.leaf,*.jsonl
# The table file's upload at the end: 9.7 GB.
FINAL_UPLOAD_SECONDS=900
