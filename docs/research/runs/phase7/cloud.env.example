# The Phase 7 run's tools/cloud settings (README.md in this folder, "The run, step by step"):
# the plan job, from the leaf build to the repeat, on one machine. Copy to
# ~/.config/pokerscribe/cloud-phase7.env, fill in PROJECT, BUCKET and SERVICE_ACCOUNT there
# (the Phase 6 run's), and keep the copy outside the repo. Every setting is explained in
# tools/cloud/settings.example.env; the ones left out keep their defaults.

PROJECT=
BUCKET=
SERVICE_ACCOUNT=
# A new run in the same bucket as Phase 6's: gs://<BUCKET>/runs/hu-phase7-512m/.
RUN_NAME=hu-phase7-512m
REGION=us-central1
ZONE=us-central1-a
ZONES=us-central1-a,us-central1-b,us-central1-c,us-central1-f

# 64 Arm cores and 128 GB, as Phase 6. The job holds the 16-lane leaf tables (22.2 GB) once,
# shared by every deal in play, plus the blueprint and up to 63 blocks of deals in play
# (README.md, "Sizes and costs").
MACHINE_TYPE=c4a-highcpu-64
PROVISIONING=SPOT
PREEMPTION_NOTICE_SECONDS=120
# us-central1, Google's pricing pages read 27 Nov 2026. Read the current Spot price before the
# launch.
SPOT_PRICE_PER_HOUR=1.445888
STANDARD_PRICE_PER_HOUR=2.42432
SPOT_IP_PRICE_PER_HOUR=0.0025
DISK_PRICE_PER_GB_MONTH=0.08
DISK_THROUGHPUT_PRICE_PER_MONTH=0.04
# The parts (22.2 GB), the table file put together from them (22.2 GB), the bundle (0.64 GB)
# and 30 GB for the system and the Rust build need about 75 GB. The job saves nothing big on
# SIGTERM: each part (0.65 GB) and each result is uploaded as it is written.
DISK_SIZE_GB=120
DISK_TYPE=hyperdisk-balanced
DISK_THROUGHPUT_MBPS=400
DISK_IOPS=
CHECKPOINT_GB=0.01
ARTIFACTS_GB=23
# About 45 GB projected in a match, 70 GB if every deal in play held a solve as large as the
# bench's (README.md, "Sizes and costs"); check wants the machine to have it with 10% to spare.
TRAINER_MEMORY_GB=70

# About 5 to 10 hours at $1.476 an hour, $7 to $15 (README.md, "Sizes and costs"): $20 buys
# 13.3 hours after the margin. If the cap stops it, raise BUDGET_USD and resume: the parts and
# the results done are kept.
BUDGET_USD=20
BUDGET_MARGIN_MINUTES=15

TRAINER_MODE=build
TRAINER_CARGO_BIN=search
TRAINER_CARGO_PACKAGE=search
TRAINER_CONFIG=docs/research/runs/phase7/phase7.json
# The Phase 6 strategy file and the bucket tables it was trained with. On the machine they are
# /opt/pscloud/bundle/files/strategy-512000000.bps and /opt/pscloud/bundle/files/k200, the
# paths phase7.json names. Change the first path if the file is elsewhere on this computer.
TRAINER_FILES=~/phase6/run1/strategy-512000000.bps,~/abstraction/k200
# Empty: the job uses every core of the machine (the bench makes its own pool of 4).
TRAINER_ARGS=
# The job's checkpoint is plan.ckpt (the plan's fingerprint and its step). Its artifacts are
# the leaf table parts (part-NNNNN.leafpart, 34 of 0.65 GB, kept so a new machine puts the
# table file together again without building them) and the results (*.json, and the LBR
# deals, *.deals). The table file (*.leaf, 22.2 GB) is not uploaded.
CHECKPOINT_PATTERN=*.ckpt
KEEP_CHECKPOINTS=3
ARTIFACT_PATTERNS=*.leafpart,*.json,*.deals,*.jsonl
# The last results are small; the parts are uploaded as they are written.
FINAL_UPLOAD_SECONDS=600
