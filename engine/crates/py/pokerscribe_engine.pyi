"""Type stubs for pokerscribe_engine (the module itself is Rust: src/). See README.md."""
from typing import Any, Dict, Iterable, List, Optional, Protocol, Sequence, Tuple, Union

__version__: str
MAX_PLAYERS: int
MAX_RANK: int

# "Ah", or the engine's number for the card: rank * 4 + suit (suits c, d, h, s).
Card = Union[str, int]
# A list or tuple of cards, or one string such as "AhKd" or "Ah Kd".
Cards = Union[str, Iterable[Card]]
# What a Python agent's act() returns: "fold", "check", "call", or ("raise", amount) where
# amount is the total bet of the street ("bet" is another name for "raise").
Answer = Union[str, Tuple[str, Optional[int]]]

def card_index(card: Card) -> int: ...
def card_string(index: Card) -> str: ...
def eval5(cards: Cards) -> int: ...
def eval6(cards: Cards) -> int: ...
def eval7(cards: Cards) -> int: ...
def hand_category(rank: int) -> str: ...
def new_hand(
    stacks: List[int],
    small_blind: int,
    big_blind: int,
    ante: int = 0,
    button: int = 0,
    *,
    seed: Optional[int] = None,
    hole: Optional[Iterable[Cards]] = None,
    board: Optional[Cards] = None,
) -> "State": ...

