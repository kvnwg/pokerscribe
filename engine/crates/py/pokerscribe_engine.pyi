class Agent(Protocol):
    """A Python agent: act() is required; name, begin_hand() and end_hand() are optional."""
    name: str
    def act(self, view: View) -> Answer: ...
    def begin_hand(self, view: View) -> None: ...
    def end_hand(self, view: View) -> None: ...

class MatchReport:
    """The arena's report of a match (format "pokerscribe-arena/1")."""
    def to_dict(self) -> Dict[str, Any]: ...
    def to_json(self) -> str: ...
    def summary(self) -> str: ...
    def save(self, path: str) -> None: ...
    def result(self, agent: Union[str, int]) -> Optional[Dict[str, Any]]: ...

