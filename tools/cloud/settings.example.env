# Settings for tools/cloud. Copy this file to ~/.config/pokerscribe/cloud.env and fill it in.
# Keep the copy outside the repo: it names your project and bucket. Any setting can also be
# given as an environment variable with a PSCLOUD_ prefix (PSCLOUD_BUDGET_USD=25), which wins.
# Empty means "not set" (the default applies).

# --- where ---------------------------------------------------------------------------------
PROJECT=
BUCKET=
# Lowercase letters, digits and dashes. Checkpoints go to gs://<BUCKET>/runs/<RUN_NAME>/.
RUN_NAME=hu-blueprint-1
REGION=us-central1
ZONE=us-central1-a
# Zones to try, in order, when a new machine has to be made (no capacity in ZONE). C4A is
# offered in us-central1-a, -b, -c and -f (27 Nov 2026); python -m tools.cloud check shows
# which of these have the machine type.
ZONES=us-central1-a,us-central1-b,us-central1-c,us-central1-f
# Default: ps-<RUN_NAME>
INSTANCE_NAME=

# --- the machine ---------------------------------------------------------------------------
# c4a-highcpu-64: 64 Arm cores with 128 GB, the Phase 6 blueprint's machine (it needs 9 GB
# at most). c4a-highmem-64: the same 64 cores with 512 GB, for a trainer that needs more
# memory (its prices are below); c4a-standard-64 has 256 GB.
MACHINE_TYPE=c4a-highcpu-64
# SPOT (cheap, can be stopped by Google) or STANDARD (on-demand)
PROVISIONING=SPOT
# Spot only. 120 asks Google for 2 minutes' notice before the 30-second shutdown, so a big
# checkpoint has time to be saved and uploaded. It uses `gcloud beta`. 0: no notice.
PREEMPTION_NOTICE_SECONDS=120
# Room for at least 4 checkpoints (the trainer's .tmp, the new one, the one being uploaded,
# and one spare) plus 30 GB for the system and the Rust build.
# CHECKPOINT_GB and ARTIFACTS_GB below make check and launch refuse a disk that is too small.
DISK_SIZE_GB=200
# C4A takes Hyperdisk only. On Hyperdisk Balanced both values are always sent (Google needs
# them together), an empty one as the free baseline (3,000 IOPS, 140 MiB/s); left to Google,
# the disk would get more by its size, and cost more. On the baseline, writing a 5 GB
# checkpoint takes about 35 s at best, and
# reading it for the upload as long again (README, "Disk speed and big checkpoints"). More
# costs extra, by the month: see DISK_IOPS_PRICE_PER_MONTH and DISK_THROUGHPUT_PRICE_PER_MONTH.
DISK_TYPE=hyperdisk-balanced
DISK_IOPS=
DISK_THROUGHPUT_MBPS=
IMAGE_FAMILY=debian-12-arm64
IMAGE_PROJECT=debian-cloud
# Default: the project's default compute service account (with storage read/write scope).
# Better: a service account that may only write to the bucket (README, Setup step 6).
SERVICE_ACCOUNT=
NETWORK=
SUBNET=
EXTERNAL_IP=true

# --- prices (USD) and the cap ----------------------------------------------------------------
# c4a-highcpu-64 in us-central1, read 27 Nov 2026 on Google's Spot and general-purpose
# pricing pages (docs/research/BENCHMARKS.md). c4a-highmem-64 the same day: Spot 2.250752,
# on-demand 3.77216. Spot prices move: read the current one before each run.
SPOT_PRICE_PER_HOUR=1.445888
STANDARD_PRICE_PER_HOUR=2.42432
# An external IPv4 address, per hour while the machine runs: on an on-demand machine
# (IP_PRICE_PER_HOUR) and on a Spot machine (SPOT_IP_PRICE_PER_HOUR), 27 Nov 2026.
IP_PRICE_PER_HOUR=0.005
SPOT_IP_PRICE_PER_HOUR=0.0025
# The boot disk, per GB per month, billed while the disk exists (also while stopped):
# Hyperdisk Balanced, $0.000109589 per GiB an hour (27 Nov 2026).
DISK_PRICE_PER_GB_MONTH=0.08
# Hyperdisk Balanced, per month: each IOPS above the free 3,000, and each MiB/s above the
# free 140 (27 Nov 2026). Counted in the cost estimate when DISK_IOPS or DISK_THROUGHPUT_MBPS
# asks for more.
DISK_IOPS_PRICE_PER_MONTH=0.005
DISK_THROUGHPUT_PRICE_PER_MONTH=0.04
# The hard cap. The supervisor stops the trainer (it saves) and powers the machine off when
# the estimated cost reaches BUDGET_USD minus BUDGET_MARGIN_MINUTES of running; Google stops
# the machine at the cap itself (--max-run-duration), whatever the supervisor does.
BUDGET_USD=
BUDGET_MARGIN_MINUTES=15

# --- recovery ------------------------------------------------------------------------------
MAX_RESTARTS=10
RECREATE_AFTER_FAILED_STARTS=3
# false: only a Spot preemption is restarted. A stop from the console is left alone.
RESTART_ANY_STOP=false
RECOVER_POLL_SECONDS=60

# --- the trainer -----------------------------------------------------------------------------
# build: cargo builds TRAINER_CARGO_BIN from ENGINE_DIR on the machine (native Arm build);
# copy: TRAINER_PATH is copied as it is (an aarch64 Linux binary, or a script such as
# tools/cloud/fake_trainer.py for a cheap end-to-end test).
TRAINER_MODE=build
TRAINER_PATH=
TRAINER_CARGO_BIN=
TRAINER_CARGO_PACKAGE=
TRAINER_CARGO_FEATURES=
RUST_TOOLCHAIN=stable
# Default: the repo's engine/ folder.
ENGINE_DIR=
# The file passed as --config. It is copied to the machine.
TRAINER_CONFIG=
# Extra arguments, shell-quoted, e.g. --threads 64
TRAINER_ARGS=
# Local files or folders the trainer reads, comma-separated (the bucket tables, say). Each goes
# into the bundle and is installed at /opt/pscloud/bundle/files/<its name> on the machine; a
# config that names a path there must have it listed here (check says so).
TRAINER_FILES=
CHECKPOINT_PATTERN=*.ckpt
KEEP_CHECKPOINTS=3
# Other files the trainer writes in its folder that go to artifacts/ in the bucket and are all
# kept (none are deleted): the blueprint's strategy files and stages.jsonl. A new machine gets
# them back. none: off.
ARTIFACT_PATTERNS=*.bps,*.jsonl
# Measured sizes, optional. TRAINER_MEMORY_GB: the trainer's peak memory (check compares it to
# the machine type's). CHECKPOINT_GB, ARTIFACTS_GB: one checkpoint, and all the artifacts.
TRAINER_MEMORY_GB=
CHECKPOINT_GB=
ARTIFACTS_GB=
STATUS_SECONDS=60
STOP_GRACE_SECONDS=600
FINAL_UPLOAD_SECONDS=600
MAX_TRAINER_CRASHES=3
POWER_OFF_WHEN_DONE=true
